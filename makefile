TARGET = cheatER

SRCDIR = src
OBJS = \
	$(SRCDIR)/main.o \
	$(SRCDIR)/common.o \
	$(SRCDIR)/cheat.o \
	$(SRCDIR)/cheat_file.o \
	$(SRCDIR)/file_buffer.o \
	$(SRCDIR)/game_pause.o \
	$(SRCDIR)/hooks.o \
	$(SRCDIR)/hotkeys.o \
	$(SRCDIR)/menu_state.o \
	$(SRCDIR)/menu_draw.o \
	$(SRCDIR)/menu_draw_edit.o \
	$(SRCDIR)/menu_draw_tabs.o \
	$(SRCDIR)/font.o \
	$(SRCDIR)/menu_input.o \
	$(SRCDIR)/menu_input_edit.o \
	$(SRCDIR)/menu_input_tabs.o \
	$(SRCDIR)/search.o \
	$(SRCDIR)/mips.o \
	$(SRCDIR)/float_format.o \
	$(SRCDIR)/screenshot.o \
	$(SRCDIR)/usb.o \
	$(SRCDIR)/module.o \
	exports.o

# Firmware version the PSPSDK headers target (was #define _PSP_FW_VERSION 150 in crt0_prx.c)
PSP_FW_VERSION = 150

# Define to build this as a prx (instead of a static elf)
BUILD_PRX=1
# Define the name of our custom exports (minus the .exp extension)
PRX_EXPORTS=exports.exp

USE_KERNEL_LIBS = 1
USE_KERNEL_LIBC = 1

INCDIR = include
# -std=gnu17: this code uses old-style "int f()" declarations, which C23 (GCC 15's default) treats differently
# -fno-builtin-stpcpy: stop GCC rewriting strcat/sprintf into stpcpy, which the kernel libc doesn't have
CFLAGS = -O2 -G0 -msingle-float -g -std=gnu17 -fno-builtin-stpcpy
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
ASFLAGS = $(CFLAGS)

LIBDIR =
LIBS = -lpspchnnlsv -lpsputility -lpspdebug -lpspge_driver -lpspwlan -lpspumd -lpsppower -lpspusb -lpspusbstor -lpspsdk -lpsppower_driver
LDFLAGS = -nostdlib  -nodefaultlibs -g

# Use the toolchain in ~/pspdev if it isn't already on PATH (e.g. when run as "wsl make")
ifeq ($(shell command -v psp-config 2>/dev/null),)
export PSPDEV ?= $(HOME)/pspdev
export PATH := $(PSPDEV)/bin:$(PATH)
PSPBIN = $(PSPDEV)/bin/
PSPSDK=$(shell $(PSPDEV)/bin/psp-config --pspsdk-path)
else
PSPSDK=$(shell psp-config --pspsdk-path)
endif
include $(PSPSDK)/lib/build.mak

# Full compiler paths, so CLion's Makefile import can find psp-gcc and read its include paths
ifdef PSPBIN
CC  = $(PSPBIN)psp-gcc
CXX = $(PSPBIN)psp-g++
AS  = $(PSPBIN)psp-gcc
LD  = $(PSPBIN)psp-gcc
endif

# exports.c is generated by psp-build-exports and uses an old pattern the compiler warns about
exports.o: CFLAGS += -w
